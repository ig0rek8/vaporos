#!/usr/bin/env bash
# ==============================================================================
# vaporos-ctl — Open-Source VaporOS Control Center (CLI + Interactive Menu)
# ==============================================================================
set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vaporos"
GAMING_CONF="$CONF_DIR/gaming.conf"
mkdir -p "$CONF_DIR"

BLUE='\033[1;34m'
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

show_status() {
    echo -e "${CYAN}=== VaporOS System Status ===${RESET}"
    echo -e "Kernel:    $(uname -r)"
    echo -e "Device:    $(/usr/local/bin/vaporos-power-status --summary 2>/dev/null || echo 'Unknown')"
    echo -e "Session:   ${XDG_CURRENT_DESKTOP:-tty}"
    echo -e "Memory:    $(free -h | awk '/^Mem:/ {print $3 " / " $2 " (Available: " $7 ")"}')"
    echo -e "ZRAM:      $(swapon --show --noheadings 2>/dev/null | awk '{print $1 " " $3 " used:" $4}' | head -n 1 || echo 'none')"
    echo -e "GPU:       $(lspci 2>/dev/null | grep -iE 'vga|3d|display' | sed 's/.*: //' | head -n 1)"
    echo -e "Governor:  $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'n/a')"
    echo ""
}

configure_gaming_display() {
    echo -e "${CYAN}Configure Gaming Mode Display (Gamescope)${RESET}"
    read -r -p "Width  (e.g. 1920, empty=auto): " w
    read -r -p "Height (e.g. 1080, empty=auto): " h
    read -r -p "Refresh rate Hz (e.g. 60, 120, 144): " r
    {
        [[ -n "$w" ]] && echo "VAPOROS_WIDTH=$w"
        [[ -n "$h" ]] && echo "VAPOROS_HEIGHT=$h"
        [[ -n "$r" ]] && echo "VAPOROS_REFRESH=$r"
    } > "$GAMING_CONF"
    echo -e "${GREEN}Saved to $GAMING_CONF${RESET}"
}

install_optional_apps() {
    echo -e "${CYAN}Install Optional Apps (Base OS stays bloat-free)${RESET}"
    echo "1) Firefox (Browser)"
    echo "2) Lutris + Wine (Non-Steam games)"
    echo "3) Flatpak + Flathub (Discover / Heroic / Discord / etc.)"
    echo "4) Back"
    read -r -p "Select [1-4]: " opt
    case "$opt" in
        1) sudo pacman -S --needed firefox ;;
        2) sudo pacman -S --needed lutris wine-staging winetricks ;;
        3)
            sudo pacman -S --needed flatpak
            flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
            echo -e "${GREEN}Flathub enabled! Example: flatpak install flathub com.heroicgameslauncher.hgl${RESET}"
            ;;
        *) return ;;
    esac
}

# Support direct subcommands
case "${1:-}" in
    status) show_status; exit 0 ;;
    gaming) exec /usr/local/bin/vaporos-switch-session gaming ;;
    desktop) exec /usr/local/bin/vaporos-switch-session desktop ;;
    update) sudo pacman -Syu; exit $? ;;
esac

# Interactive menu
while true; do
    clear
    echo -e "${BLUE}╔══════════════════════════════════════════════╗${RESET}"
    echo -e "${BLUE}║        VaporOS Control Center (Arch)         ║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════╝${RESET}"
    show_status
    echo "1) 🎮 Switch to Gaming Mode (Gamescope + Steam)"
    echo "2) 🖥  Switch to Desktop Mode (Hyprland)"
    echo "3) 📺 Configure Gaming Mode Resolution / Refresh Rate"
    echo "4) 📦 Install Optional Apps (Firefox / Lutris / Flatpak)"
    echo "5) 🔄 Update System (pacman -Syu)"
    echo "6) 💾 Install VaporOS to Disk (vaporos-install)"
    echo "0) Exit"
    echo ""
    read -r -p "Choose an option: " choice
    case "$choice" in
        1) /usr/local/bin/vaporos-switch-session gaming; exit 0 ;;
        2) /usr/local/bin/vaporos-switch-session desktop; exit 0 ;;
        3) configure_gaming_display; read -r -p "Press Enter..." _ ;;
        4) install_optional_apps; read -r -p "Press Enter..." _ ;;
        5) sudo pacman -Syu; read -r -p "Press Enter..." _ ;;
        6) sudo /usr/local/bin/vaporos-install; read -r -p "Press Enter..." _ ;;
        0|q|Q) exit 0 ;;
        *) echo -e "${YELLOW}Invalid option${RESET}"; sleep 1 ;;
    esac
done
