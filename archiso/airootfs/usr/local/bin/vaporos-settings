#!/usr/bin/env python3
"""
VaporOS Settings — Clean, restrained native desktop settings UI.
Sans-serif typography, grouped preference rows, switches, segmented controls, zero bloat.
"""
import os
import subprocess
import threading
import time
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib


CSS = b"""
* {
    background-image: none;
    text-shadow: none;
    -gtk-icon-shadow: none;
    box-shadow: none;
}
window, dialog {
    background-color: #191d24;
    color: #d0d7e0;
    font-family: "Adwaita Sans", "DejaVu Sans", sans-serif;
    font-size: 13px;
}
.sidebar {
    background-color: #14171c;
    border-right: 1px solid #222731;
    padding: 14px 10px;
}
.sidebar-hdr {
    font-size: 13px;
