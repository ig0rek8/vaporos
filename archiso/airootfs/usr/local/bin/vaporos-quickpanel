#!/usr/bin/env python3
"""
VaporOS Quick Drawer — Restrained matte-graphite control panel with smooth slide/fade animation.
Running while already open sends SIGUSR1 to animate-close cleanly.
"""
import os
import signal
import subprocess
import sys

PID_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "vaporos-quickpanel.pid")

# Preload libgtk-layer-shell for native Wayland overlay anchoring
LAYER_SO = "/usr/lib/libgtk-layer-shell.so"
if os.path.exists(LAYER_SO) and LAYER_SO not in os.environ.get("LD_PRELOAD", ""):
    env = os.environ.copy()
    env["LD_PRELOAD"] = f"{LAYER_SO}:{env['LD_PRELOAD']}" if env.get("LD_PRELOAD") else LAYER_SO
    os.execve(sys.executable, [sys.executable] + sys.argv, env)

# Toggle: if already running, ask it to animate-close via SIGUSR1
if os.path.exists(PID_FILE):
    try:
        with open(PID_FILE, "r") as f:
            old_pid = int(f.read().strip())
        os.kill(old_pid, signal.SIGUSR1)
        sys.exit(0)
    except Exception:
        try:
            os.remove(PID_FILE)
        except OSError:
            pass

with open(PID_FILE, "w") as f:
    f.write(str(os.getpid()))

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

HAS_LAYER_SHELL = False
try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell
    HAS_LAYER_SHELL = True
except Exception:
    pass


CSS = b"""
