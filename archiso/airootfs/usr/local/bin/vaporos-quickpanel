    background-image: none;
    text-shadow: none;
    -gtk-icon-shadow: none;
    box-shadow: none;
}
window {
    background-color: transparent;
    border: none;
    color: #cfd8e3;
    font-family: "Adwaita Sans", "DejaVu Sans", "JetBrainsMono Nerd Font", sans-serif;
    font-size: 12.5px;
}
.drawer-frame {
    background-color: rgba(25, 29, 36, 0.97);
    border: 1px solid #283242;
