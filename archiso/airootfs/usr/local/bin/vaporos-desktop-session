#!/usr/bin/env bash
# ==============================================================================
# VaporOS Desktop Mode Session (Hyprland Wayland)
# Auto-enables VM-safe Wayland/software rendering flags in VirtualBox/VMware/QEMU.
# ==============================================================================
set -u

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland

# Wayland toolkit hints
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND="wayland,x11,*"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Auto-detect VM (VirtualBox, VMware, QEMU, Hyper-V) and enable safe rendering
if systemd-detect-virt -q 2>/dev/null; then
    export WLR_NO_HARDWARE_CURSORS=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
    export AQ_NO_MODIFIERS=1
    if [[ ! -e /dev/dri/renderD128 ]]; then
        export LIBGL_ALWAYS_SOFTWARE=1
    fi
fi

# Balanced CPU governor in Desktop Mode
for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [[ -w "$gov" ]] && echo schedutil > "$gov" 2>/dev/null || true
done

exec Hyprland
