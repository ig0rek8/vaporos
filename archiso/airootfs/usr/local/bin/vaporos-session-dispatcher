#!/usr/bin/env bash
# ==============================================================================
# VaporOS Session Dispatcher
# Defaults to Desktop Mode (normal Arch Linux + Hyprland).
# Inside the system, users can switch to Gaming Mode (gamescope + Steam)
# and back seamlessly without rebooting.
# ==============================================================================
set -u

STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vaporos"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
NEXT_SESSION_FILE="$STATE_DIR/next-session"
SWITCH_FLAG="$CACHE_DIR/vaporos-switch-requested"
LOG_FILE="$CACHE_DIR/vaporos-session.log"

mkdir -p "$STATE_DIR" "$CACHE_DIR"

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

# Respect kernel boot parameter (default: desktop)
if [[ ! -f "$NEXT_SESSION_FILE" ]]; then
    if grep -qw "vaporos.mode=gaming" /proc/cmdline 2>/dev/null; then
        echo "gaming" > "$NEXT_SESSION_FILE"
    elif grep -qw "vaporos.mode=tty" /proc/cmdline 2>/dev/null; then
        echo "tty" > "$NEXT_SESSION_FILE"
    else
        echo "desktop" > "$NEXT_SESSION_FILE"
    fi
fi

# Ensure user PipeWire audio daemon is ready
systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null || true

while true; do
    TARGET_MODE="$(tr -d '[:space:]' < "$NEXT_SESSION_FILE" 2>/dev/null || echo "desktop")"
    rm -f "$SWITCH_FLAG"

    case "$TARGET_MODE" in
        tty)
            echo "VaporOS Safe Shell (user: gamer | pass: gamer)"
            echo "Run 'vaporos-desktop-session' for Hyprland or 'vaporos-gaming-session' for Gaming Mode."
            exec /usr/bin/bash --login
            ;;
        gaming)
            log "Starting Gaming Mode (gamescope + Steam Big Picture)"
            START_TS=$(date +%s)
            /usr/local/bin/vaporos-gaming-session >> "$LOG_FILE" 2>&1
            EXIT_CODE=$?
            END_TS=$(date +%s)
            DURATION=$((END_TS - START_TS))
            log "Gaming Mode exited with code $EXIT_CODE after ${DURATION}s"

            # Always return to Desktop Mode if gamescope exits or fails
            if [[ ! -f "$SWITCH_FLAG" ]]; then
                echo "desktop" > "$NEXT_SESSION_FILE"
                touch "$SWITCH_FLAG"
            fi
            ;;
        desktop|*)
            log "Starting Desktop Mode (Hyprland)"
            START_TS=$(date +%s)
            /usr/local/bin/vaporos-desktop-session >> "$LOG_FILE" 2>&1
            EXIT_CODE=$?
            END_TS=$(date +%s)
            DURATION=$((END_TS - START_TS))
            log "Desktop Mode exited with code $EXIT_CODE after ${DURATION}s"

            # If user didn't request switching to Gaming Mode:
            if [[ ! -f "$SWITCH_FLAG" ]]; then
                if [[ $DURATION -lt 5 && $EXIT_CODE -ne 0 ]]; then
                    echo ""
                    echo "=== VaporOS: Hyprland failed to start (exit $EXIT_CODE) ==="
                    echo "Log: $LOG_FILE"
                    tail -n 15 "$LOG_FILE" 2>/dev/null || true
                    echo ""
                    echo "Dropping to interactive bash shell. You can run 'vaporos-ctl' or 'Hyprland'."
                    exec /usr/bin/bash --login
                fi
                # Clean logout -> return to greetd (tuigreet)
                exit 0
            fi
            ;;
    esac

    sleep 0.5
done
