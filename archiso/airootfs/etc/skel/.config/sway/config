# ==============================================================================
# VaporOS Sway Configuration (SteamOS-themed Desktop Mode — VM & Fallback)
# Matches Hyprland keybindings & Waybar Gaming Mode button 1:1.
# ==============================================================================

set $mod Mod4
set $term foot
set $menu fuzzel

# Background (SteamOS deep slate)
output * bg #0e141b solid_color

# Keyboard layout (US + RU via Alt+Shift)
input type:keyboard {
    xkb_layout "us,ru"
    xkb_options "grp:alt_shift_toggle"
}

# Window borders (SteamOS blue)
default_border pixel 2
gaps inner 5
gaps outer 8
client.focused          #1a9fff #16202a #ffffff #66c0f4 #1a9fff
client.unfocused        #232d3b #0e141b #8f98a0 #232d3b #232d3b

# Autostart
exec waybar
exec mako
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Keybindings
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+space exec $menu
bindsym $mod+e exec thunar
bindsym $mod+g exec /usr/local/bin/vaporos-switch-session gaming
bindsym $mod+c exec foot -T "VaporOS Control Center" /usr/local/bin/vaporos-ctl

bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

floating_modifier $mod normal

bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym Print exec grim -g "$(slurp)" - | wl-copy
