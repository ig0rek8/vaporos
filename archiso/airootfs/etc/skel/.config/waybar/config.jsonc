{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,

    "modules-left": [
        "custom/apps",
        "custom/gaming",
        "hyprland/workspaces",
        "sway/workspaces",
        "hyprland/window",
        "sway/window",
        "custom/close-window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "custom/battery",
        "custom/power"
    ],

    "custom/apps": {
        "format": "⊞ Apps",
        "tooltip-format": "Open Applications Grid (GNOME-style)",
        "on-click": "pkill -x nwg-drawer || nwg-drawer -mb 16 -mr 16 -ml 16 -mt 16 -c 6 -is 64 -ovl -pbpoweroff 'systemctl poweroff' -pbreboot 'systemctl reboot' -pblock 'vaporos-switch-session gaming'"
    },

    "custom/gaming": {
        "format": "🎮 Gaming Mode",
        "tooltip-format": "Switch to Steam Big Picture (Gamescope)",
        "on-click": "/usr/local/bin/vaporos-switch-session gaming"
    },

    "custom/close-window": {
        "format": "✕",
        "tooltip-format": "Закрыть активное окно",
        "on-click": "/usr/local/bin/vaporos-close-window"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "VaporOS Control Center & Power",
        "on-click": "foot -T 'VaporOS Control Center' /usr/local/bin/vaporos-ctl"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "sway/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "max-length": 40
    },

    "sway/window": {
        "max-length": 40
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM {used:0.1f}G",
        "interval": 3
    },

    "pulseaudio": {
        "format": "🔊 {volume}%",
        "format-muted": "🔇",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "WiFi {signalStrength}%",
        "format-ethernet": "ETH",
        "format-disconnected": "Offline",
        "on-click": "foot -T 'Network' nmtui"
    },

    "custom/battery": {
        "exec": "/usr/local/bin/vaporos-power-status",
        "return-type": "json",
        "interval": 5,
        "hide-empty-text": true
    }
}
