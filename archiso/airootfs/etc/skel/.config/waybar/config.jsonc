{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,

    "modules-left": [
        "custom/gaming",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/vaporctl",
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "battery"
    ],

    "custom/gaming": {
        "format": "🎮 Gaming Mode",
        "tooltip-format": "Switch back to Steam Big Picture (Gamescope)",
        "on-click": "/usr/local/bin/vaporos-switch-session gaming"
    },

    "custom/vaporctl": {
        "format": "⚙ VaporOS",
        "tooltip-format": "Open VaporOS Control Center",
        "on-click": "foot -T 'VaporOS Control Center' /usr/local/bin/vaporos-ctl"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "max-length": 45
    },

    "clock": {
        "format": "{:%H:%M  %d.%m}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM {used:0.1f}G",
        "interval": 3
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTED",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "WiFi {signalStrength}%",
        "format-ethernet": "ETH",
        "format-disconnected": "Offline",
        "on-click": "foot -T 'Network' nmtui"
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%"
    }
}
